#cloud-config
hostname: ${VMNAME}

# Set timezone
timezone: Asia/Kolkata

users:
  - name: abhinav
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    groups: [adm, sudo]
    lock_passwd: true
    ssh_authorized_keys:
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFlhgbdbSihtKNB6ZPanKv1JS+rLIQkdQZ1QdVkOBU/K abhinav@regisedge.com
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIE63HTM8PVDl3lUgajqg4/4LSuwWqnXeRZ9pO6zrD7V2 abhinav@regisedge.com
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGTbOjHUI2i/lpQAERy1bUrbCd68aRG9s1pAjXbPwrwI abhinav@regisedge.com

package_update: true
package_upgrade: true
package_reboot_if_required: true   # reboot once at first boot if the kernel/libs need it

packages:
  - curl
  - vim
  - htop
  - tmux
  - ufw
  - unattended-upgrades
  - qemu-guest-agent

write_files:
  - path: /etc/apt/apt.conf.d/20auto-upgrades
    content: |
      APT::Periodic::Update-Package-Lists "1";
      APT::Periodic::Unattended-Upgrade "1";

runcmd:
  - systemctl enable --now qemu-guest-agent
  - touch /etc/cloud/cloud-init.disabled

# Add SSH config restrictions
ssh_pwauth: false   # disable password SSH login entirely
disable_root: true  # disable root login

final_message: "VM is up. Total: $UPTIME seconds."
