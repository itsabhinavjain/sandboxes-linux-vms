#!/usr/bin/env bash
# Copy the relevant bits of this into /etc/profile.d/sandbox.sh (see SETUP.md)
# or source it directly before running the lifecycle scripts.

export SANDBOX_HOME="${SANDBOX_HOME:-$HOME/projects}"
export LIBVIRT_HOME="${STORAGE_POOL_HOME:-$SANDBOX_HOME/libvirt}"

# Storage pools (see PLAN.md for what belongs in each)
export STORAGE_POOL_IMAGES="${LIBVIRT_HOME}/images"       # base cloud .img files
export STORAGE_POOL_ISOS="${LIBVIRT_HOME}/isos"           # reserved, unused by cloud-image flow
export STORAGE_POOL_DISKS="${LIBVIRT_HOME}/disks"         # per-VM qcow2 + seed ISO + state.yaml
export STORAGE_POOL_SNAPSHOTS="${LIBVIRT_HOME}/snapshots" # reserved for Phase 6

# Base image + VM defaults
export DEFAULT_CLOUD_IMG="noble-server-cloudimg-amd64"
export DEFAULT_OS_VARIANT="ubuntu24.04"
export DEFAULT_RAM_MB="2048"
export DEFAULT_VCPUS="2"
export DEFAULT_DISK_GB="20"

# Whether new VMs autostart when libvirtd starts (e.g. after a host reboot).
# This is optional -- 00_init.sh falls back to "false" if unset, so leaving
# this out of your existing sandbox.sh is fine. Override per-VM with
# --autostart / --no-autostart on 00_init.sh.
export DEFAULT_AUTOSTART="false"

# Used for SSH connection hints (vmname.<tailnet>.ts.net) and the
# ssh-keygen -R reminder printed by 05_destroy.sh. Set this to your tailnet
# name, e.g. "tailnet-name.ts.net" or leave unset if you don't use Tailscale.
export TAILSCALE_TAILNET=""
